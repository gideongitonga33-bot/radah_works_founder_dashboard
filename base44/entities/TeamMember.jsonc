{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "role_id": {
      "type": "string",
      "title": "Team Role ID"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "role_title": {
      "type": "string",
      "title": "Role Title"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "part_time",
        "on_leave",
        "departed"
      ],
      "default": "active",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "project_id",
    "name",
    "role_title"
  ]
}